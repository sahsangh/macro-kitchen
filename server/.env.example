# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include a database name, e.g. /calrecipe
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/calrecipe?retryWrites=true&w=majority
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
# Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY works but is heavily rate limited)
USDA_API_KEY=DEMO_KEY
PORT=4000
