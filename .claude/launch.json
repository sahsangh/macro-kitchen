{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd mobile && npx expo start --web --port 8081"
      ],
      "port": 8081
    },
    {
      "name": "api-test",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd server && MONGODB_URI=memory PORT=4100 node src/index.js"
      ],
      "port": 4100,
      "autoPort": false
    },
    {
      "name": "web-test",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd mobile && EXPO_PUBLIC_API_URL=http://localhost:4100 npx expo start --web --port 8096"
      ],
      "port": 8096,
      "autoPort": false
    }
  ]
}